# Copy to .env (git-ignored) and fill in. Check with: bash scripts/uv-run.sh python scripts/check_keys.py
ANTHROPIC_API_KEY=
# Retell AI dashboard -> API Keys ($10 credit per innovator)
RETELL_API_KEY=
# Any long random string; it is part of the voice bridge's websocket path (docs/voice.md)
RETELL_WS_SECRET=
# Filled in after the first run of scripts/retell_setup.py
RETELL_AGENT_ID=
# Terminal49 developer portal (live data on 1M+ containers)
TERMINAL49_API_KEY=
# Where the Streamlit UI finds the API
DUALUSE_API_URL=http://localhost:8000
