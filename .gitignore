# Secrets: copy .env.example to .env and fill in keys locally.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Environments
.venv/
.venv_wsl/
.venv_win/

# Local data, model weights and scratch output
data/
# The vendored map plugin's county boundary and source list are code assets.
!/crisisfusion_map/data/
*.pth
*.pt
*.safetensors
*.log
.tmp/

# Streamlit local secrets
.streamlit/secrets.toml

# Editors
.idea/
.vscode/

# Claude Code: share settings, hooks and skills; keep the rest local.
/.claude/*
!/.claude/settings.json
!/.claude/hooks/
!/.claude/skills/
!/.claude/launch.json

# Codex
/.codex
